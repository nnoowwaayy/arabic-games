# Optional PostgreSQL backend. Without this, the app uses its provisioned D1 database.
# For the hosted Worker, use a Prisma Accelerate / Prisma Postgres HTTP URL.
# DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"
# Set runtime secrets through Sites, or use .dev.vars for local Worker development.
# ADMIN_EMAIL="you@example.com"
